{
  "description": "AxiorHub Pseudonymisation : vérifie au démarrage que Claude Code passe par le proxy local et bloque l'envoi d'un message contenant des données personnelles lorsque le proxy n'est pas actif.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/check_proxy.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/guard_prompt.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
